{
  "headers": [
    {
      "source": "/(.*\\..*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://fwbccpayjjbmwpefiwqp.supabase.co/functions/v1/sitemap"
    },
    {
      "source": "/@:username*",
      "destination": "https://fwbccpayjjbmwpefiwqp.supabase.co/functions/v1/seo-page?path=/@:username"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
