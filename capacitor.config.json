{
  "appId": "com.bookonmap.app",
  "appName": "BookOnMap",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "Geolocation": {
      "permissions": ["location"]
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "Badge": {
      "persist": true,
      "autoClear": false
    }
  }
}
